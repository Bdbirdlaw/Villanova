# ==========================================================
# Nova Nation Exchange — Server config
# Copy to .env and fill in. Never commit your real .env.
# ==========================================================

# Public-facing base URL of the server. Used for magic-link emails,
# Stripe success/cancel callbacks, and Stripe Connect onboarding links.
PUBLIC_URL=http://localhost:4242
PORT=4242

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me_from_stripe_listen

# Resend — https://resend.com/api-keys
# Without this, emails are logged to console in dev mode.
RESEND_API_KEY=
EMAIL_FROM="Nova Nation Exchange <noreply@novanation.example>"

# SQLite file location. Default: ./data/novanation.db
# DB_PATH=/var/lib/novanation.db

# Used to sign session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_random_64_hex_chars
