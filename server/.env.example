# =================================================================
# Nova Nation Exchange — Stripe backend
# Copy to .env and fill in. Never commit your real .env.
# =================================================================

# Stripe test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# From `stripe listen --forward-to localhost:4242/api/webhooks/stripe`
# (Stripe CLI prints `whsec_...` on startup.)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Server
PORT=4242
PUBLIC_URL=http://localhost:4242
